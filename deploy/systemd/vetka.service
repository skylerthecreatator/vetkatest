[Unit]
Description=Vetka website
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/vetka
EnvironmentFile=-/etc/vetka.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /var/www/vetka/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
